      "id": "c238b228-a4ba-4522-8ea1-21224e447b7f",
      "name": "HTTP Request: API Detecciones - Página 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        14848,
        16016
      ],
      "continueOnFail": true,
      "notes": "⚠️ IMPORTANTE: Reemplazar 'TU_API_KEY_AQUI' en el nodo 'Set: API Key' con tu API key real"
    },
    {
      "parameters": {
        "jsCode": "// Filtrar detecciones por campaña (filtrado local, NO en API)\n// Estructura real del API: { status, client, meta: { current_page, per_page, total_records, total_pages }, data: [...] }\n// Estructura de cada detección: { channel_id, channel_name, city, datetime_utc, duration_seg, spot_id, spot_name }\nconst response = $input.first().json;\nconst detecciones = response.data || [];\nconst orden = $('Split In Batches - Por Campaña').item.json;\nconst meta = response.meta || {};\n\n// Función para parsear fecha RFC 2822 a YYYY-MM-DD\nconst parsearFechaRFC2822 = (fechaStr) => {\n  if (!fechaStr) return null;\n  try {\n    const fecha = new Date(fechaStr);\n    if (isNaN(fecha.getTime())) return null;\n    const año = fecha.getFullYear();\n    const mes = String(fecha.getMonth() + 1).padStart(2, '0');\n    const dia = String(fecha.getDate()).padStart(2, '0');\n    return `${año}-${mes}-${dia}`;\n  } catch (e) {\n    return null;\n  }\n};\n\n// Sin spot_id/spot_name en la orden: match por cliente o campaña en spot_name del API (primera vez)\nconst ordenSinSpot = !orden.spot_id && !orden.spot_name;\nconst matchPorClienteOCampaña = (d) => {\n  if (!d.spot_name) return false;\n  const sn = d.spot_name.toLowerCase();\n  if (orden.cliente && sn.includes(orden.cliente.toLowerCase())) return true;\n  if (orden.campaña && sn.includes(orden.campaña.toLowerCase())) return true;\n  return false;\n};\n\nconst filtradas = detecciones.filter(d => {\n  const fechaStr = parsearFechaRFC2822(d.datetime_utc);\n  if (!fechaStr) return false;\n  const enRango = fechaStr >= orden.periodo_inicio && fechaStr <= orden.periodo_fin;\n  if (!enRango) return false;\n  \n  const coincideSpot = (\n    (orden.spot_name && d.spot_name && (\n      d.spot_name.toLowerCase().includes(orden.spot_name.toLowerCase()) ||\n      orden.spot_name.toLowerCase().includes(d.spot_name.toLowerCase())\n    )) ||\n    (orden.spot_id && d.spot_id && d.spot_id === orden.spot_id) ||\n    (orden.emisora && d.channel_name && (\n      d.channel_name.toLowerCase().includes(orden.emisora.toLowerCase()) ||\n      orden.emisora.toLowerCase().includes(d.channel_name.toLowerCase())\n    )) ||\n    (orden.emisora && d.channel_id && orden.channel_id && d.channel_id === orden.channel_id) ||\n    (ordenSinSpot && matchPorClienteOCampaña(d))\n  );\n  return coincideSpot;\n});\n\n// Si la orden no tenía spot_id/spot_name y encontramos detecciones, rellenar orden para la próxima vez\nconst actualizar_orden_spot = ordenSinSpot && filtradas.length > 0;\nconst spot_id_obtenido = actualizar_orden_spot ? (filtradas[0].spot_id || null) : null;\nconst spot_name_obtenido = actualizar_orden_spot ? (filtradas[0].spot_name || null) : null;\n\nconst paginaActual = meta.current_page || 1;\nconst totalPaginas = meta.total_pages || 1;\nconst tieneMasPaginas = paginaActual < totalPaginas;\n\nreturn [{\n  json: {\n    detecciones_filtradas: filtradas,\n    total_filtradas: filtradas.length,\n    total_recibidas: detecciones.length,\n    orden: orden,\n    tiene_mas_paginas: tieneMasPaginas,\n    pagina_actual: paginaActual,\n    total_paginas: totalPaginas,\n    actualizar_orden_spot: actualizar_orden_spot,\n    spot_id_obtenido: spot_id_obtenido,\n    spot_name_obtenido: spot_name_obtenido\n  }\n}];"
      },
