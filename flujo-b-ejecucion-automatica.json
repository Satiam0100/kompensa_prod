    {
      "parameters": {
        "jsCode": "// Pruebas: dia simulado como 'hoy' (YYYY-MM-DD).\n// Usa null para fecha real o un string entre comillas, por ejemplo: '2026-02-02'\nconst FECHA_EJECUCION_PRUEBA = '2026-04-13';\n\nconst valorPrueba = FECHA_EJECUCION_PRUEBA == null ? '' : String(FECHA_EJECUCION_PRUEBA).trim();\nif (valorPrueba && !/^\\d{4}-\\d{2}-\\d{2}$/.test(valorPrueba)) {\n  throw new Error(\"FECHA_EJECUCION_PRUEBA debe estar entre comillas y en formato YYYY-MM-DD\");\n}\n\nconst hoyEfectivo = valorPrueba ? new Date(`${valorPrueba}T12:00:00Z`) : new Date();\nif (Number.isNaN(hoyEfectivo.getTime())) {\n  throw new Error(\"Fecha invalida en FECHA_EJECUCION_PRUEBA\");\n}\n\nconst fechaHoy = hoyEfectivo.toISOString().split('T')[0];\nconst esDomingo = hoyEfectivo.getUTCDay() === 0;\n\n// Ventana semanal: 7 dias incluyendo fecha_hoy (hoy y 6 dias hacia atras)\nconst inicioSemanaDate = new Date(hoyEfectivo);\ninicioSemanaDate.setUTCDate(inicioSemanaDate.getUTCDate() - 6);\nconst periodoInicioSemana = inicioSemanaDate.toISOString().split('T')[0];\nconst periodoFinSemana = fechaHoy;\n\nreturn [{\n  json: {\n    fecha_hoy: fechaHoy,\n    es_domingo: esDomingo,\n    generar_certificado: true,\n    periodo_inicio_semana: periodoInicioSemana,\n    periodo_fin_semana: periodoFinSemana,\n    fecha_prueba_usada: valorPrueba || null\n  }\n}];"
      },
      "id": "717c0fcf-a907-465f-b158-20e34e409e45",
      "name": "Code: Calcular Fechas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        13504,
        16016
      ]
    },
    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\n\nconst inicio = f.periodo_inicio_semana;\nconst fin = f.periodo_fin_semana;\n\nconst getISOWeek = (dateStr) => {\n  const date = new Date(`${dateStr}T00:00:00Z`);\n  const d = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));\n  const dayNum = d.getUTCDay() || 7;\n  d.setUTCDate(d.getUTCDate() + 4 - dayNum);\n  const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));\n  const weekNo = Math.ceil((((d - yearStart) / 86400000) + 1) / 7);\n  return { year: d.getUTCFullYear(), week: String(weekNo).padStart(2, '0') };\n};\n\nconst w = getISOWeek(inicio);\nconst runStamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);\nconst folderName = `Semana_${w.year}-W${w.week}_inicio_${inicio}_fin_${fin}_run_${runStamp}`;\n\nreturn [{\n  json: {\n    ...f,\n    carpeta_semana_nombre: folderName\n  }\n}];"
      },
