    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\n\nconst inicio = f.periodo_inicio_semana;\nconst fin = f.periodo_fin_semana;\n\nconst getISOWeek = (dateStr) => {\n  const date = new Date(`${dateStr}T00:00:00Z`);\n  const d = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));\n  const dayNum = d.getUTCDay() || 7;\n  d.setUTCDate(d.getUTCDate() + 4 - dayNum);\n  const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));\n  const weekNo = Math.ceil((((d - yearStart) / 86400000) + 1) / 7);\n  return { year: d.getUTCFullYear(), week: String(weekNo).padStart(2, '0') };\n};\n\nconst w = getISOWeek(inicio);\nconst runStamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);\nconst folderName = `Semana_${w.year}-W${w.week}_inicio_${inicio}_fin_${fin}_run_${runStamp}`;\n\nreturn [{\n  json: {\n    ...f,\n    carpeta_semana_nombre: folderName\n  }\n}];"
      },
