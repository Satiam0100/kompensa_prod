      "parameters": {
        "jsCode": "// Pruebas: dia simulado como 'hoy' (YYYY-MM-DD).\n// Usa null para fecha real o un string entre comillas, por ejemplo: '2026-02-02'\nconst FECHA_EJECUCION_PRUEBA = null;\n\nconst valorPrueba = FECHA_EJECUCION_PRUEBA == null ? '' : String(FECHA_EJECUCION_PRUEBA).trim();\nif (valorPrueba && !/^\\d{4}-\\d{2}-\\d{2}$/.test(valorPrueba)) {\n  throw new Error(\"FECHA_EJECUCION_PRUEBA debe estar entre comillas y en formato YYYY-MM-DD\");\n}\n\nconst hoyEfectivo = valorPrueba ? new Date(`${valorPrueba}T12:00:00Z`) : new Date();\nif (Number.isNaN(hoyEfectivo.getTime())) {\n  throw new Error(\"Fecha invalida en FECHA_EJECUCION_PRUEBA\");\n}\n\nconst fechaHoy = hoyEfectivo.toISOString().split('T')[0];\nconst esDomingo = hoyEfectivo.getUTCDay() === 0;\n\n// Ventana semanal solo para carpeta Drive (métricas/API usan campaña completa)\nconst inicioSemanaDate = new Date(hoyEfectivo);\ninicioSemanaDate.setUTCDate(inicioSemanaDate.getUTCDate() - 6);\nconst periodoInicioSemana = inicioSemanaDate.toISOString().split('T')[0];\nconst periodoFinSemana = fechaHoy;\n\nreturn [{\n  json: {\n    fecha_hoy: fechaHoy,\n    es_domingo: esDomingo,\n    generar_certificado: false,\n    periodo_inicio_semana: periodoInicioSemana,\n    periodo_fin_semana: periodoFinSemana,\n    fecha_prueba_usada: valorPrueba || null\n  }\n}];"
      },
