    {
      "parameters": {
        "jsCode": "return items\n  .filter(i => {\n    const c = i.json[\"Completitud (Conteo)\"];\n    return c && c !== \"Anunciante\" && c !== \"Resumen General\";\n  })\n  .map(i => {\n    return {\n      json: {\n        Cliente: i.json[\"Completitud (Conteo)\"],\n        Frec: i.json[\"__EMPTY\"],\n        Estación: i.json[\"__EMPTY_1\"],\n        Campaña: i.json[\"__EMPTY_2\"],\n        Línea_Negocio: i.json[\"__EMPTY_3\"],\n        Version: i.json[\"__EMPTY_4\"],\n        Total_Cuñas_Transmitidas: Number(i.json[\"__EMPTY_27\"])\n      }\n    };\n  })\n  .slice(0, 1);\n"
      },
