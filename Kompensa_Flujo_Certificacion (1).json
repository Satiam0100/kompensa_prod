    {
      "parameters": {
        "jsCode": "// Validación segura de los inputs\nif (!items[0] || !items[1]) {\n  return [\n    {\n      json: {\n        error: \"No se recibieron los dos objetos requeridos: reporte y orden.\",\n        itemsLength: items.length,\n        msg: \"Verifica el flujo anterior (ej. nodo Merge) para asegurar que ambos objetos estén presentes.\"\n      }\n    }\n  ];\n}\n\nconst rep = items[0].json;\nconst ord = items[1].json;\n\n// Convertir los valores contratados / transmitidos a número con seguridad\nconst contratadas = ord.Total_Cuñas_Contratadas ? Number(ord.Total_Cuñas_Contratadas) : 0;\nconst transmitidas = rep.Total_Cuñas_Transmitidas ? Number(rep.Total_Cuñas_Transmitidas) : 0;\n\n// Calcular faltantes sin que caiga en negativo\nlet faltantes = contratadas - transmitidas;\nif (faltantes < 0) {\n  // En caso de detección de exceso, ajusta a cero o registra como “exceso”\n  faltantes = 0;\n}\n\n// Porcentaje de cumplimiento\nconst porcentaje = contratadas > 0\n  ? ( (transmitidas / contratadas) * 100 ).toFixed(1) + '%'\n  : 'N/A';\n\nreturn [\n  {\n    json: {\n      Cliente: ord.Cliente || null,\n      Producto: ord.Producto || null,\n      Emisora: ord.Emisora || null,\n      Contratadas: contratadas,\n      Transmitidas: transmitidas,\n      Faltantes: faltantes,\n      PorcentajeCumplimiento: porcentaje,\n      // espacio para agregar futura propiedad de desglose diario\n      DetalleComparacion: ord.DetalleProgramadoPorDia && rep.DetallePorDia\n        ? []  // aquí más adelante puedes cruzar los arrays por día\n        : undefined\n    }\n  }\n];\n"
      },
