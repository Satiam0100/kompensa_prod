    {
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nconst order = {};\nconst detalleProg = [];\n\n// Primero extraer los campos generales\nfor (const r of rows) {\n  const key = r.col_1;\n  const value = r.col_2;\n  if (!key) continue;\n  switch (key.trim()) {\n    case 'Cliente':\n      order.Cliente = value;\n      break;\n    case 'Producto':\n      order.Producto = value;\n      break;\n    case 'Emisora':\n      order.Emisora = value;\n      break;\n    case 'Dias de transmisión':\n      order.DiasTransmision = value;\n      break;\n    case 'Cuñas diarias':\n      order.CuñasDiarias = Number(value);\n      break;\n    case 'Total cuñas':\n      order.Total_Cuñas_Contratadas = Number(value);\n      break;\n    case 'Periodo':\n      order.Periodo_Inicio = r.col_2;\n      order.Periodo_Fin = r.col_8;\n      break;\n  }\n}\n\n// Luego localizar la fila del desglose diario (por ejemplo, bajo “Emisora” como etiqueta)\nconst filaDesglose = rows.find(r => r.col_1 === order.Emisora);\nif (filaDesglose) {\n  // Suponiendo que col_2 → día 1, col_3 → día 2, etc.\n  for (let i = 2; i < 2 + 31; i++) {\n    const dia = i - 1;\n    const cuñasProg = Number(filaDesglose[`col_${i}`]) || 0;\n    detalleProg.push({ dia: dia, programadas: cuñasProg });\n  }\n}\n\n// Devolver estructura con detalle\nreturn [{\n  json: {\n    Cliente: order.Cliente,\n    Producto: order.Producto,\n    Emisora: order.Emisora,\n    DiasTransmision: order.DiasTransmision,\n    CuñasDiarias: order.CuñasDiarias,\n    Periodo_Inicio: order.Periodo_Inicio,\n    Periodo_Fin: order.Periodo_Fin,\n    Total_Cuñas_Contratadas: order.Total_Cuñas_Contratadas,\n    DetalleProgramadoPorDia: detalleProg\n  }\n}];\n"
      },
